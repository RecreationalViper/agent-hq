{
  "note": "Settings for the GitHub Radar (scout/scan.mjs). Edit this file to steer what gets scanned. Queries use normal GitHub search syntax. {since} is replaced automatically with a rolling date so results stay fresh.",
  "limits": {
    "queriesPerRun": 12,
    "minStars": 8,
    "maxReportPerCategory": 5,
    "shortlistSize": 5,
    "queryDelayMs": 2200,
    "inspectSkillFiles": 4,
    "seenCap": 1500
  },
  "targets": {
    "skills": [
      "topic:claude-skills stars:>5 pushed:>{since}",
      "topic:agent-skills stars:>5 pushed:>{since}",
      "topic:skills in:name,description,readme stars:>15 pushed:>{since}",
      "\"SKILL.md\" agent skills in:readme stars:>10 pushed:>{since}",
      "topic:mcp-server stars:>200 pushed:>{since}",
      "awesome agent skills in:name,description stars:>150 pushed:>{since}",
      "topic:agent-toolkit stars:>5 pushed:>{since}"
    ],
    "enhancement": [
      "topic:llm-tooling stars:>150 pushed:>{since}",
      "topic:prompt-engineering stars:>300 pushed:>{since}",
      "topic:context-engineering stars:>20 pushed:>{since}",
      "topic:ai-agents stars:>500 pushed:>{since}",
      "\"model agnostic\" llm in:description stars:>80 pushed:>{since}",
      "topic:llm-evaluation stars:>200 pushed:>{since}",
      "topic:ai-coding-agent stars:>200 pushed:>{since}"
    ],
    "free-tokens": [
      "\"free tier\" llm api in:readme stars:>150 pushed:>{since}",
      "topic:free-llm-api stars:>5 pushed:>{since}",
      "\"free credits\" llm in:description stars:>30 pushed:>{since}",
      "\"free tokens\" llm in:description,readme stars:>30 pushed:>{since}",
      "topic:openrouter stars:>30 pushed:>{since}",
      "topic:free-api stars:>30 pushed:>{since}",
      "\"no api key required\" llm in:description stars:>100 pushed:>{since}"
    ],
    "efficiency": [
      "topic:llm-cost stars:>10 pushed:>{since}",
      "token reduction llm in:name,description stars:>20 pushed:>{since}",
      "topic:prompt-compression stars:>5 pushed:>{since}",
      "topic:llm-router stars:>50 pushed:>{since}",
      "topic:semantic-cache stars:>100 pushed:>{since}",
      "topic:llm-gateway stars:>150 pushed:>{since}",
      "\"context compression\" in:readme stars:>50 pushed:>{since}",
      "topic:local-llm stars:>500 pushed:>{since}"
    ]
  },
  "trustedOrgs": [
    "openai",
    "anthropics",
    "google",
    "googleapis",
    "google-gemini",
    "microsoft",
    "meta-llama",
    "facebookresearch",
    "huggingface",
