    "mistralai",
    "xai-org",
    "moonshotai",
    "cohere-ai",
    "togethercomputer",
    "openrouter",
    "berriai",
    "vercel",
    "simonw",
    "obra",
    "steipete",
    "anthropic-experimental",
    "google-gemini"
  ],
  "trustedHosts": [
    "openrouter.ai",
    "ai.google.dev",
    "aistudio.google.com",
    "cloud.google.com",
    "anthropic.com",
    "claude.ai",
    "openai.com",
    "platform.openai.com",
    "mistral.ai",
    "groq.com",
    "cerebras.ai",
    "together.ai",
    "fireworks.ai",
    "huggingface.co",
    "deepinfra.com",
    "sambanova.ai",
    "nvidia.com",
    "cloudflare.com",
    "github.blog",
    "docs.github.com",
    "z.ai",
    "moonshot.cn",
    "x.ai",
    "ollama.com",
    "lmstudio.ai",
    "litellm.ai",
    "opencode.ai",
    "crush.sh",
    "windsurf.com",
    "cursor.com"
  ],
  "blockPatterns": [
    "(?i)(free|unlimited|no.?limit)[^.]{0,30}(api|openai|anthropic|claude|gemini)[^.]{0,30}(key|keys)[^.]{0,20}(gen|generator|giveaway|pool)",
    "(?i)\\b(keygen|cracked|warez|nulled|patched.?premium|premium.?apk)\\b",
    "(?i)(account|key|token).{0,12}(generator|rotator|farm|harvester)",
    "(?i)\\b(carding|cvv|credential.?dump|stealer|phishing|otp.?bypass|sms.?bypass)\\b",
    "(?i)(bypass|evade).{0,25}(verification|phone|sms|kYC|paywall|rate.?limit)",
    "(?i)(scrape|scraper).{0,20}(api.?key|api.?keys|credential)",
    "(?i)\\b(sell|selling|buy).{0,15}(api.?key|api.?keys|accounts?)\\b"
  ],
  "blockPatternsFreeTokensOnly": [
    "(?i)\\b(airdrop|memecoin|presale|token.?sale|pump\\.fun|shitcoin)\\b",
    "(?i)\\b(solana|ethereum|binance|web3)\\b.{0,30}\\b(free|earn|reward|claim)\\b",
    "(?i)\\b(claim|earn|farm).{0,20}\\b(free )?(tokens|coins)\\b.{0,20}\\b(wallet|connect)\\b"
  ],
  "riskPatterns": [
    {
      "name": "third-party-proxy",
      "pattern": "(?i)(reverse.?proxy|api.?proxy|relay|key.?pool|shared.?key|free.?key.?pool)",
      "why": "Your prompts and data pass through someone else's server. Never paste your own API key into one."
    },
    {
      "name": "tos-risk",
      "pattern": "(?i)(reverse.?engineer|scrap(e|ing).{0,15}(cookie|session)|unofficial.?api|bypass)",
      "why": "Built on scraping or unofficial access. Can break, and may breach the provider's terms."
    },
    {
      "name": "hype-claims",
      "pattern": "(?i)(unlimited|infinite|100% free forever|no limits)",
      "why": "Big promise in the description. Verify the small print before relying on it."
    },
    {
      "name": "self-host-required",
      "pattern": "(?i)(docker compose|self-host|kubernetes|helm chart)",
      "why": "Needs a server or a computer running. Fine for a laptop, not for an iPhone-only workflow."
    }
  ]
}
